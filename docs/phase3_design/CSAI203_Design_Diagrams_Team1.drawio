idth="140" height="510" as="geometry" /></mxCell><mxCell id="d9_n9" value="change answer / reopen" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="7582.0" as="sourcePoint" /><mxPoint x="300" y="7582.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="d9_n10" value="save or resume request" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="7632.0" as="sourcePoint" /><mxPoint x="490" y="7632.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="d9_n11" value="validate owner / deadline" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="7682.0" as="sourcePoint" /><mxPoint x="680" y="7682.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="d9_n12" value="save idempotent response" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="7732.0" as="sourcePoint" /><mxPoint x="870" y="7732.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="d9_n13" value="upsert answer + savedAt" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="7782.0" as="sourcePoint" /><mxPoint x="1060" y="7782.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="d9_n14" value="on resume: load saved attempt" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=